VITE_APP_NAME=Estim8r
VITE_APP_URL=https://estim8r.currentflowconsulting.org
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BUILDR_URL=
VITE_BUILDR_API_URL=
# Production Pages builds also read these from GitHub secrets.
# If they are empty in a production build, Estim8r falls back to https://buildrpm.com.

# Live supplier catalog search. Server-side only — do not prefix with VITE_
# (that would expose distributor keys in the browser bundle).
# Local: put these in .env / .env.local for the Vite proxy at /api/live-supplier-catalog.
# Production: supabase secrets set NAME=value && supabase functions deploy search-supplier-catalog
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_SANDBOX=false
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
ELEMENT14_API_KEY=
ELEMENT14_STORE_ID=us


# Authorized supplier pricing gateway (server-side only).
# Used for Home Depot, Lowe's, City Electric Supply, Inline Electric Supply,
# Wesco / Anixter, Graybar, Grainger, and MSC Industrial when direct public
# catalog APIs are not available to the app. The gateway must implement:
# POST {SUPPLIER_GATEWAY_URL}/search
# Authorization: Bearer {SUPPLIER_GATEWAY_TOKEN}
# JSON body: { supplier, supplierName, query, quantity, limit }
# Response: { results: [{ sku, mpn, description, unitCost, currency, availability, url }] }
SUPPLIER_GATEWAY_URL=
SUPPLIER_GATEWAY_TOKEN=
