--- src/domain/takeoff/drawingObjectLayer.js
+++ src/domain/takeoff/drawingObjectLayer.js
@@ -104,10 +104,21 @@ function objectContainsPoint(item, point) {
 
 export function buildDrawingObjectLayer({ pages = [], detectedMarks = [], trade = "electrical" } = {}) {
   const objects = (detectedMarks || []).filter(isDeviceMark).map((mark) => ({
     ...mark,
     objectId: mark.objectId || `drawing-object:${mark.id}`,
     sourceMarkId: mark.id,
     objectKind: "recognized-device",
+    // For point devices without an outline (like OS without geometry), add a minimal
+    // circle so they are hit-testable and can be selected.
+    outline: mark.outline || (/^(OS|GFI|GFI\/WP|WP|SP|SPR)$/i.test(mark.typeCode || mark.abbr || "")
+      ? {
+        kind: "circle",
+        source: "generic",
+        cx: mark.x,
+        cy: mark.y,
+        r: 0.32,
+      }
+      : mark.outline),
     selectable: true,
     editable: true,
   }));
